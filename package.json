{
  "name": "Mobile Automation Assessment",
  "type": "module",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.6.2",
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "allure-commandline": "^2.46.1",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "cross-env": "^10.1.0",
    "expect-webdriverio": "^6.1.0"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.ts",
    "wdio:android": "cross-env PLATFORM=android wdio run ./wdio.conf.ts",
    "wdio:ios": "cross-env PLATFORM=ios wdio run ./wdio.conf.ts",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  }
}
